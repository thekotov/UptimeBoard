# Postgres
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor

# Backend
DATABASE_URL=postgresql+psycopg2://monitor:monitor@postgres:5432/monitor
REDIS_URL=redis://redis:6379/0

# Auth — CHANGE jwt_secret in production!
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MIN=720

# Seed admin (used by `docker compose run --rm api python -m scripts.seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Probes / retention
RESULT_RETENTION_DAYS=30
PROBE_DEFAULT_INTERVAL=60
PROBE_DEFAULT_TIMEOUT=10

# Worker: concurrent probe checks (probes are I/O-bound; raise for many probes)
WORKER_MAX_THREADS=50

# DB connection pool. Peak connections per process = DB_POOL_SIZE + DB_MAX_OVERFLOW.
# When raising WORKER_MAX_THREADS, raise these too (else threads queue for a
# connection). Keep (api + worker) totals under Postgres max_connections (~100).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Re-send an alert if an incident is still open after N minutes (0 = off)
ALERT_REPEAT_MIN=0
# Coalesce down/resolved alerts for the same server within N seconds (0 = off)
ALERT_GROUP_WINDOW_SEC=60
# Delay the first "opened" alert for a service by N seconds so other servers in
# the same service that go down within the window get folded into one combined
# alert instead of N separate messages (0 = off, send immediately)
ALERT_STORM_WINDOW_SEC=9
# A probe is "stale" if not checked within interval * factor + grace seconds
STALE_FACTOR=3
STALE_GRACE_SEC=30

# CORS: "*" or comma-separated origins
CORS_ORIGINS=*

# Public base URL of the status site (e.g. https://uptime.example.com).
# Used to build clickable links in alerts. Empty = no link.
PUBLIC_BASE_URL=
